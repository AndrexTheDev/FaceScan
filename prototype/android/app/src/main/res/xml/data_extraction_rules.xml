<?xml version="1.0" encoding="utf-8"?>
<!--
  Biometrische Daten duerfen NICHT in Cloud-Backups oder Gerätetransfers
  wandern. Deshalb: nur der noetigste Schluessel bleibt lokal, alles andere
  wird ausgeschlossen (docs/06).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="projects" />
        <exclude domain="file" path="vault.key" />
    </device-transfer>
</data-extraction-rules>
